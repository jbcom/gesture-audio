{
  "name": "gesture-audio",
  "version": "0.1.2",
  "description": "Gesture-gated Tone.js bus graph + Howler sprite resolver + preferences bridge. Solves browser autoplay unlock.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./build-tools": {
      "import": {
        "types": "./dist/types/build-tools/index.d.ts",
        "default": "./dist/esm/build-tools/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/build-tools/index.d.cts",
        "default": "./dist/cjs/build-tools/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:types && pnpm run build:types-cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/rename-cjs.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run check:docs && pnpm run check:imports && pnpm run check:package && pnpm run docs:build",
    "build:types-cjs": "tsc -p tsconfig.types-cjs.json && node scripts/rename-cts.mjs",
    "check:package": "publint && attw --pack .",
    "check:docs": "node scripts/check-docs.mjs",
    "check:imports": "node scripts/smoke-imports.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:watch": "vitest",
    "docs:dev": "pnpm --filter gesture-audio-docs dev",
    "docs:build": "pnpm --filter gesture-audio-docs build && node scripts/check-sourcey-output.mjs",
    "docs:validate": "pnpm --filter gesture-audio-docs validate && node scripts/check-sourcey-output.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "howler": "^2.2.4",
    "tone": "^15.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.10",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "howler": "^2.2.4",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "tone": "^15.1.22",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/gesture-audio.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/gesture-audio/issues"
  },
  "homepage": "https://github.com/jbcom/gesture-audio#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.23.0",
  "keywords": [
    "audio",
    "tone.js",
    "howler",
    "autoplay",
    "web-audio",
    "gesture",
    "unlock",
    "audio-sprite"
  ],
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "typesVersions": {
    "*": {
      "build-tools": [
        "./dist/types/build-tools/index.d.ts"
      ]
    }
  }
}
